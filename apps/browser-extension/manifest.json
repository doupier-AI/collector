{
  "manifest_version": 3,
  "name": "Collector Capture",
  "version": "0.1.0",
  "description": "Capture selected text or pages into Collector Inbox.",
  "permissions": ["contextMenus", "storage", "notifications", "alarms", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1:43110/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icon.svg", "32": "icon.svg", "48": "icon.svg", "128": "icon.svg" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_title": "Collector Capture", "default_icon": "icon.svg", "default_popup": "popup.html" }
}
