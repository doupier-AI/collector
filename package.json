{
  "name": "collector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "evals/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @collector/web",
    "test": "npm run build && node --test dist-tests/**/*.test.js scripts/*.test.mjs",
    "start": "node apps/api/dist/launcher-main.js",
    "launch": "npm run build && node apps/api/dist/launcher-main.js",
    "launch:mvp": "npm run build && node scripts/launch-mvp.mjs",
    "start:service": "node apps/api/dist/server.js",
    "dev:api": "npm run build && node apps/api/dist/server.js",
    "dev:web": "npm run dev -w @collector/web",
    "test:web": "npm run test -w @collector/web",
    "test:e2e": "node scripts/run-e2e-batch.mjs",
    "test:e2e:functional": "npm run build && node scripts/run-e2e.mjs functional",
    "test:e2e:special": "npm run build && node scripts/run-e2e.mjs special",
    "test:e2e:visual": "npm run build && node scripts/run-e2e.mjs visual",
    "check": "powershell -ExecutionPolicy Bypass -File scripts/check-project.ps1",
    "gate": "node scripts/gate.mjs",
    "gate:fast": "node scripts/gate.mjs fast",
    "gate:e2e": "node scripts/gate.mjs e2e",
    "eval:answer-quality": "npm run build && node scripts/run-answer-quality-eval.mjs",
    "eval:long-form-gate": "npm run build && node scripts/run-long-form-gate.mjs",
    "probe:evidence-preparation": "npm run build && node scripts/probe-evidence-preparation.mjs",
    "probe:citation-attribution": "npm run build && node scripts/probe-citation-attribution.mjs",
    "clean": "node scripts/clean.mjs",
    "worktree:remove": "node scripts/worktree-safety.mjs remove",
    "run:logged": "node scripts/run-logged.mjs",
    "visual:diff": "node scripts/visual-review.mjs",
    "preview:data": "node scripts/preview-data.mjs --snapshot-only",
    "preview:from-main": "npm run build && node scripts/preview-data.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pdf-lib": "^1.17.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.3"
  }
}
