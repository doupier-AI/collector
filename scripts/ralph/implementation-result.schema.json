{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changedFiles", "tests", "openQuestions"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "needs_human", "failed"]
    },
    "summary": {
      "type": "string"
    },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
